<%- include('page-start') %><div class="page-head"><div><h1>Audit Log</h1><p class="muted">500 aktivitas terbaru.</p></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Waktu</th><th>User</th><th>Role</th><th>Aksi</th><th>Entity</th><th>Hasil</th><th>IP</th></tr></thead><tbody><% if(items.length){items.forEach(a=>{ %><tr><td><%= a.timestamp %></td><td><%= a.username||'-' %></td><td><%= a.role||'-' %></td><td><strong><%= a.action %></strong></td><td><%= a.entity||'-' %><%= a.entity_id?' #'+a.entity_id:'' %></td><td><span class="badge <%= a.result==='success'?'badge-ok':'badge-bad' %>"><%= a.result %></span></td><td class="small"><%= a.ip_address||'-' %></td></tr><% })}else{ %><tr><td colspan="7" class="muted">Belum ada log.</td></tr><% } %></tbody></table></div><%- include('page-end') %>
