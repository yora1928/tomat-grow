<%- include('page-start') %><div class="page-head"><div><h1>Backup</h1><p class="muted">Cadangkan dan pulihkan database aplikasi.</p></div><form method="post" action="/backup/buat"><button class="btn btn-primary">Buat Backup Sekarang</button></form></div><section class="card"><h2>Restore Database</h2><form method="post" action="/backup/restore" class="form-grid" onsubmit="return confirm('Restore akan mengganti database aktif. Lanjutkan?')"><label>Backup Folder<select name="folder" required><option value="">Pilih backup</option><% folders.forEach(f=>{ %><option value="<%= f %>"><%= f %></option><% }) %></select></label><label>Ketik RESTORE<input name="confirm" placeholder="RESTORE" required></label><div class="col-2 form-actions"><button class="btn btn-danger">Restore Database</button></div></form></section><section class="card"><h2>Riwayat Backup</h2><div class="table-wrap"><table class="table"><thead><tr><th>Waktu</th><th>Folder</th><th>Ukuran</th><th>Status</th><th>Telegram</th></tr></thead><tbody><% if(logs.length){logs.forEach(l=>{ %><tr><td><%= l.timestamp %></td><td><%= l.folder %></td><td><%= Math.round((l.size_bytes||0)/1024) %> KB</td><td><span class="badge <%= l.status==='SUCCESS'?'badge-ok':'badge-bad' %>"><%= l.status %></span></td><td><%= l.telegram_status %></td></tr><% })}else{ %><tr><td colspan="5" class="muted">Belum ada backup.</td></tr><% } %></tbody></table></div></section><%- include('page-end') %>
