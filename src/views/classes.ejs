<%- include('page-start') %><div class="page-head"><div><h1>Kelas</h1><p class="muted">Daftar kelas dan statusnya.</p></div></div><form method="post" action="/kelas/baru" class="filter-bar"><input name="kode_kelas" placeholder="X-A" required><input name="nama_kelas" placeholder="Kelas X-A" required><input name="tingkat" value="X" placeholder="Tingkat"><button class="btn btn-primary">Tambah Kelas</button></form><div class="table-wrap"><table class="table"><thead><tr><th>Kode</th><th>Nama</th><th>Tingkat</th><th>Status</th><th></th></tr></thead><tbody><% items.forEach(c=>{ %><tr><td><strong><%= c.kode_kelas %></strong></td><td><%= c.nama_kelas %></td><td><%= c.tingkat %></td><td><span class="badge <%= c.status==='Aktif'?'badge-ok':'' %>"><%= c.status %></span></td><td class="right"><form method="post" action="/kelas/<%= c.id %>/toggle" class="inline"><button class="btn btn-sm"><%= c.status==='Aktif'?'Nonaktifkan':'Aktifkan' %></button></form></td></tr><% }) %></tbody></table></div><%- include('page-end') %>
