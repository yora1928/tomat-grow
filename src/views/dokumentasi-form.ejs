<%- include('page-start') %><div class="page-head"><div><h1><%= mode==='edit'?'Ubah':'Upload' %> Dokumentasi</h1><p class="muted"><%= t.kode_tanaman %> — <%= t.nama_tanaman %></p></div></div><% if(error){ %><div class="flash flash-danger"><%= error %></div><% } %><form method="post" enctype="multipart/form-data" action="<%= mode==='edit'?'/dokumentasi/'+id+'/edit':'/dokumentasi/upload' %>" class="form-grid"><input type="hidden" name="tanaman_id" value="<%= t.id %>"><label>Tanggal<input type="date" name="tanggal" value="<%= data.tanggal||'' %>" required></label><label>Foto <%= mode==='edit'?'(opsional, isi untuk mengganti)':'' %><input type="file" name="file" accept=".jpg,.jpeg,.png,.webp" <%= mode==='create'?'required':'' %>></label><label class="col-2">Keterangan<textarea name="keterangan" rows="4"><%= data.keterangan||'' %></textarea></label><% if(mode==='edit'&&existing){ %><div class="col-2 muted small">File saat ini: <strong><%= existing.original_name||existing.filename %></strong></div><% } %><div class="col-2 form-actions"><button class="btn btn-primary"><%= mode==='edit'?'Simpan Perubahan':'Unggah Foto' %></button><a class="btn" href="/tanaman/<%= t.id %>">Batal</a></div><p class="col-2 muted small">JPG, PNG, WEBP · maksimal <%= Math.floor((5*1024*1024)/1024/1024) %> MB.</p></form><%- include('page-end') %>
