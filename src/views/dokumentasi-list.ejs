<%- include('page-start') %><div class="page-head"><div><h1>Dokumentasi</h1><p class="muted">Foto perkembangan tanaman.</p></div></div><% if(items.length){ %><div class="photo-grid"><% items.forEach(d=>{ %><figure class="card"><a href="/dokumentasi/file/<%= d.filename %>" target="_blank" rel="noopener"><img src="/dokumentasi/file/<%= d.filename %>" alt="<%= d.original_name||d.filename %>"></a><figcaption><a href="/tanaman/<%= d.tanaman_id %>"><strong><%= d.kode_tanaman %></strong></a><br><span class="muted"><%= d.tanggal %></span><% if(d.keterangan){ %><br><%= d.keterangan %><% } %><br><a href="/dokumentasi/<%= d.id %>/edit">Ubah</a></figcaption></figure><% }) %></div><% }else{ %><div class="empty">Belum ada dokumentasi.</div><% } %><%- include('page-end') %>
