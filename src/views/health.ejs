<%- include('page-start') %><div class="page-head"><div><h1>System Health</h1><p class="muted">Status layanan utama aplikasi.</p></div></div><div class="stats"><div class="stat"><span>Application</span><strong class="c-ok">OK</strong></div><div class="stat"><span>Database</span><strong class="<%= dbStatus==='OK'?'c-ok':'c-bad' %>"><%= dbStatus %></strong></div><div class="stat"><span>Disk Free</span><strong><%= diskFreeGb %> / <%= diskTotalGb %> GB</strong></div><div class="stat"><span>Telegram</span><strong><%= tgStatus %></strong></div></div><section class="card"><h2>Backup Terakhir</h2><% if(lastBackup){ %><p><strong><%= lastBackup.timestamp %></strong></p><p>Status: <span class="badge <%= lastBackup.status==='SUCCESS'?'badge-ok':'badge-bad' %>"><%= lastBackup.status %></span></p><% }else{ %><p class="muted">Belum ada backup.</p><% } %></section><%- include('page-end') %>
