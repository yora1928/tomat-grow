<%- include('page-start') %><div class="page-head"><div><h1><%= mode==='edit'?'Ubah':'Tambah' %> Jadwal</h1></div></div><% if(error){ %><div class="flash flash-danger"><%= error %></div><% } %><form method="post" action="<%= mode==='edit'?'/jadwal/'+id+'/edit':'/jadwal/baru' %>" class="form-grid"><label>Tanggal<input type="date" name="tanggal" value="<%= data.tanggal||'' %>" required></label><label>Kelas<select name="class_id" required><option value="">Pilih kelas</option><% classes.forEach(c=>{ %><option value="<%= c.id %>" <%= data.class_id==c.id?'selected':'' %>><%= c.kode_kelas %> — <%= c.nama_kelas %></option><% }) %></select></label><label>Kegiatan<input name="kegiatan" value="<%= data.kegiatan||'' %>" required></label><label>Petugas<input name="petugas" value="<%= data.petugas||'' %>"></label><label>Status<select name="status"><% STATUS_JADWAL.forEach(s=>{ %><option value="<%= s %>" <%= (data.status||'Belum Dilakukan')===s?'selected':'' %>><%= s %></option><% }) %></select></label><label class="col-2">Catatan<textarea name="catatan" rows="4"><%= data.catatan||'' %></textarea></label><div class="col-2 form-actions"><button class="btn btn-primary">Simpan</button><a class="btn" href="/jadwal">Batal</a></div></form><%- include('page-end') %>
