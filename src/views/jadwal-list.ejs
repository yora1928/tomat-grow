<%- include('page-start') %><div class="page-head"><div><h1>Jadwal</h1><p class="muted">Rencana kegiatan per kelas.</p></div><div class="actions"><a class="btn btn-primary" href="/jadwal/baru">+ Tambah Jadwal</a></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Tanggal</th><th>Kelas</th><th>Kegiatan</th><th>Petugas</th><th>Status</th><th></th></tr></thead><tbody><% if(items.length){items.forEach(j=>{ %><tr><td><%= j.tanggal %></td><td><%= j.kode_kelas %></td><td><%= j.kegiatan %></td><td><%= j.petugas||'-' %></td><td><span class="badge"><%= j.status %></span></td><td class="right"><a href="/jadwal/<%= j.id %>/edit">Ubah</a> <form method="post" action="/jadwal/<%= j.id %>/delete" class="inline" onsubmit="return confirm('Hapus jadwal ini?')"><button class="link-danger">Hapus</button></form></td></tr><% })}else{ %><tr><td colspan="6" class="muted">Belum ada jadwal.</td></tr><% } %></tbody></table></div><%- include('page-end') %>
