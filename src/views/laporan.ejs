<%- include('page-start') %><div class="page-head"><div><h1>Laporan PDF</h1><p class="muted">Buat laporan dari data tersimpan.</p></div></div><form method="get" action="/laporan/pdf" target="_blank" class="form-grid"><% if(classes.length>1){ %><label>Kelas<select name="class_id"><option value="">Semua Kelas</option><% classes.forEach(c=>{ %><option value="<%= c.id %>"><%= c.kode_kelas %> — <%= c.nama_kelas %></option><% }) %></select></label><% }else if(classes.length===1){ %><input type="hidden" name="class_id" value="<%= classes[0].id %>"><label>Kelas<input value="<%= classes[0].kode_kelas %>" disabled></label><% } %><label>Tanaman ID (opsional)<input type="number" name="tanaman_id" min="1"></label><label>Dari<input type="date" name="dari"></label><label>Sampai<input type="date" name="sampai"></label><div class="col-2 form-actions"><button class="btn btn-primary">Buat PDF</button></div></form><%- include('page-end') %>
