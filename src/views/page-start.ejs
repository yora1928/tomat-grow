<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' — ' : '' %><%= appName %></title>

<style>
*,*::before,*::after{box-sizing:border-box}
:root{--green-950:#0b3b22;--green-900:#14532d;--green-800:#166534;--green-700:#15803d;--green-600:#16a34a;--green-100:#dcfce7;--green-50:#f0fdf4;--bg:#f6f8f7;--surface:#fff;--line:#e3e8e5;--text:#16211b;--muted:#6b7770;--danger:#dc2626;--danger-bg:#fef2f2;--warn:#b45309;--warn-bg:#fffbeb;--blue:#1d4ed8;--blue-bg:#eff6ff;--sidebar:248px;--top:64px;--radius:12px;--shadow:0 2px 10px rgba(15,23,42,.045)}
html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;font-size:14px;line-height:1.5}
body{min-height:100vh}a{color:var(--green-800);text-decoration:none}a:hover{color:var(--green-950)}button,input,select,textarea{font:inherit}
.topbar{height:var(--top);position:sticky;top:0;z-index:50;display:flex;align-items:center;gap:14px;padding:0 20px;background:var(--surface);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:10px}.mark{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;color:#fff;font-weight:800;background:linear-gradient(135deg,var(--green-900),var(--green-600));letter-spacing:.4px}.mark-lg{width:56px;height:56px;font-size:20px;border-radius:14px}.brand strong{display:block;font-size:14px}.brand small{display:block;color:var(--muted);font-size:11.5px}
.userbox{margin-left:auto;display:flex;align-items:center;gap:10px}.user-name{font-weight:600}.role-pill{padding:4px 10px;border-radius:999px;font-size:10.5px;font-weight:800;letter-spacing:.3px}.role-root{background:#ede9fe;color:#5b21b6}.role-guru{background:#dbeafe;color:#1d4ed8}.role-koordinator{background:var(--green-100);color:var(--green-900)}.role-contributor{background:#eef1ef;color:#4b5a52}
.sidebar{position:fixed;left:0;top:var(--top);bottom:0;width:var(--sidebar);overflow:auto;padding:14px 10px;background:var(--surface);border-right:1px solid var(--line);z-index:40}.nav-title{padding:12px 12px 7px;color:#9aa59f;font-size:10.5px;font-weight:800;letter-spacing:.9px;text-transform:uppercase}.sidebar a{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:9px;color:#3b4941;font-size:13.5px;font-weight:600}.sidebar a:hover{background:#f3f6f4}.sidebar a.active{background:var(--green-50);color:var(--green-900)}
.content{margin-left:var(--sidebar);padding:28px 30px 60px}.auth-content{margin-left:0;padding:0}
.page-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:22px}.page-head h1{margin:0 0 4px;font-size:24px;letter-spacing:-.35px}.page-head p{margin:0}.actions{display:flex;gap:8px;flex-wrap:wrap}.muted{color:var(--muted)}.small{font-size:12px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:38px;padding:8px 13px;border:1px solid var(--line);border-radius:9px;background:#fff;color:#314038;font-weight:700;font-size:13px;cursor:pointer;transition:.15s ease}.btn:hover{background:#f5f7f6}.btn-primary{background:var(--green-700);border-color:var(--green-700);color:#fff}.btn-primary:hover{background:var(--green-800);border-color:var(--green-800);color:#fff}.btn-danger{background:var(--danger);border-color:var(--danger);color:#fff}.btn-danger:hover{background:#b91c1c}.btn-sm{min-height:32px;padding:6px 10px;font-size:12px}.btn-ghost{border-color:transparent;background:transparent}.btn-block{width:100%}.inline{display:inline}.link-danger{padding:0;border:0;background:none;color:var(--danger);font-weight:700;cursor:pointer}
.card,.table-wrap,.filter-bar,.form-grid{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}.card{padding:19px 20px;margin-bottom:16px}.card h2{margin:0 0 14px;font-size:15px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:12px;margin-bottom:20px}.stat{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:16px 17px;box-shadow:var(--shadow)}.stat span{display:block;color:var(--muted);font-size:12px}.stat strong{display:block;margin-top:5px;font-size:22px;line-height:1.15}.c-ok{color:#047857}.c-warn{color:var(--warn)}.c-bad{color:#b91c1c}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px}.filter-bar{display:flex;gap:8px;flex-wrap:wrap;padding:12px;margin-bottom:14px}.filter-bar input,.filter-bar select{min-height:38px;border:1px solid var(--line);border-radius:8px;padding:8px 10px;background:#fff}.filter-bar input{min-width:220px}
.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:680px}.table th,.table td{padding:11px 13px;border-bottom:1px solid #edf1ee;text-align:left;vertical-align:middle;font-size:13px}.table th{background:#f4f7f5;color:#65736b;font-size:10.5px;text-transform:uppercase;letter-spacing:.55px}.table tr:last-child td{border-bottom:none}.table tbody tr:hover{background:#fbfdfc}.right{text-align:right!important}
.badge{display:inline-flex;padding:4px 9px;border-radius:999px;background:#edf1ee;color:#48564e;font-size:10.5px;font-weight:800}.status-sehat{background:#dcfce7;color:#166534}.status-bermasalah{background:#fef3c7;color:#92400e}.status-mati{background:#fee2e2;color:#991b1b}.status-berbuah,.status-panen{background:#d1fae5;color:#065f46}.badge-ok{background:#dcfce7;color:#166534}.badge-bad{background:#fee2e2;color:#991b1b}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px 16px;padding:22px}.form-grid label{display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:12.5px;color:#3b4941}.form-grid input,.form-grid select,.form-grid textarea{width:100%;padding:10px 11px;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--text);outline:none}.form-grid input:focus,.form-grid select:focus,.form-grid textarea:focus{border-color:var(--green-600);box-shadow:0 0 0 3px rgba(22,163,74,.11)}.form-grid textarea{resize:vertical}.col-2{grid-column:1/-1}.form-actions{display:flex;gap:8px;padding-top:15px;border-top:1px solid var(--line);margin-top:4px}
.empty{padding:42px 22px;text-align:center;color:var(--muted);border:1px dashed var(--line);background:#fff;border-radius:var(--radius)}.mini-list,.timeline{list-style:none;padding:0;margin:0}.mini-list li{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:10px 0;border-bottom:1px solid #edf1ee}.mini-list li:last-child{border-bottom:none}.timeline li{position:relative;margin-left:8px;padding:10px 10px 10px 22px;border-left:2px solid var(--green-100)}.timeline li::before{content:"";position:absolute;left:-7px;top:15px;width:12px;height:12px;border:2px solid var(--green-600);border-radius:50%;background:#fff}.tl-date{display:inline-block;min-width:94px;color:var(--muted);font-size:12px}.tl-type{display:inline-block;margin-right:8px;padding:3px 8px;border-radius:999px;background:var(--green-50);color:var(--green-900);font-size:10px;font-weight:800;text-transform:uppercase}.chart-wrap{height:330px;position:relative}.photo-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:14px}.photo-grid figure{margin:0;overflow:hidden}.photo-grid img{width:100%;height:160px;object-fit:cover;display:block;background:#eef2ef}.photo-grid figcaption{padding:10px;font-size:12px}.flash{padding:11px 14px;border-radius:9px;margin-bottom:10px;border-left:3px solid;font-size:13px}.flash-success{background:#f0fdf4;color:#166534;border-color:#16a34a}.flash-info{background:var(--blue-bg);color:#1e40af;border-color:var(--blue)}.flash-warning{background:var(--warn-bg);color:#92400e;border-color:#d97706}.flash-danger{background:var(--danger-bg);color:#991b1b;border-color:var(--danger)}
.login-wrap{min-height:100vh;display:grid;place-items:center;padding:28px;background:linear-gradient(135deg,#effaf2,#f7faf8)}.login-card{width:min(420px,100%);background:#fff;border:1px solid var(--line);border-radius:16px;padding:34px 32px;box-shadow:0 14px 40px rgba(15,23,42,.08)}.login-brand{text-align:center;margin-bottom:25px}.login-brand h1{margin:13px 0 4px;font-size:21px}.login-brand p{margin:0;color:var(--muted)}.login-form label{display:block;margin-bottom:14px;font-size:12.5px;font-weight:700;color:#3b4941}.login-form input{display:block;width:100%;margin-top:6px;padding:11px 12px;border:1px solid var(--line);border-radius:8px}.login-hint{margin-top:18px;padding:11px 13px;border:1px solid var(--green-100);border-radius:9px;background:var(--green-50);color:var(--green-900);text-align:center;font-size:12px}
.error-page{min-height:62vh;display:grid;place-items:center;text-align:center}.error-page h1{font-size:78px;line-height:1;margin:0;color:var(--green-800)}.error-page p{max-width:620px;color:var(--muted)}
.mobile-toggle{display:none}.mobile-backdrop{display:none}
@media(max-width:980px){.sidebar{left:-var(--sidebar);transition:left .2s ease;box-shadow:6px 0 20px rgba(15,23,42,.12)}.mobile-toggle:checked~.sidebar{left:0}.mobile-toggle:checked~.mobile-backdrop{display:block;position:fixed;inset:var(--top) 0 0 0;background:rgba(15,23,42,.18);z-index:35}.content{margin-left:0;padding:20px 14px 48px}.burger{display:flex;flex-direction:column;gap:4px;cursor:pointer}.burger span{display:block;width:20px;height:2px;border-radius:2px;background:#243129}.user-name{display:none}.grid-2{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr;padding:16px}.col-2{grid-column:auto}.page-head{margin-bottom:17px}.actions{width:100%}.actions .btn{flex:1}.topbar{padding:0 14px}}
@media(max-width:560px){.brand-text{display:none}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.filter-bar input{min-width:0;width:100%}.filter-bar select,.filter-bar button{width:100%}.login-card{padding:27px 20px}.error-page h1{font-size:64px}}
</style>

</head>
<body>
<% if (user) { %>
<input class="mobile-toggle" type="checkbox" id="nav-toggle" hidden>
<header class="topbar">
  <label for="nav-toggle" class="burger" aria-label="Buka menu"><span></span><span></span><span></span></label>
  <div class="brand"><span class="mark">TG</span><div class="brand-text"><strong><%= appName %></strong><small><%= appSubtitle %></small></div></div>
  <div class="userbox"><span class="role-pill role-<%= user.role.toLowerCase() %>"><%= user.role %></span><span class="user-name"><%= user.nama %></span><form method="post" action="/logout" class="inline"><button class="btn btn-ghost btn-sm">Keluar</button></form></div>
</header>
<aside class="sidebar">
  <div class="nav-title">Monitoring</div>
  <a href="/" class="<%= currentPath==='/'?'active':'' %>">Dashboard</a>
  <a href="/tanaman" class="<%= currentPath.startsWith('/tanaman')?'active':'' %>">Data Tanaman</a>
  <a href="/pengamatan" class="<%= currentPath.startsWith('/pengamatan')?'active':'' %>">Pengamatan</a>
  <a href="/pengukuran" class="<%= currentPath.startsWith('/pengukuran')?'active':'' %>">Pengukuran</a>
  <a href="/perawatan" class="<%= currentPath.startsWith('/perawatan')?'active':'' %>">Perawatan</a>
  <a href="/dokumentasi" class="<%= currentPath.startsWith('/dokumentasi')?'active':'' %>">Dokumentasi</a>
  <a href="/jadwal" class="<%= currentPath.startsWith('/jadwal')?'active':'' %>">Jadwal</a>
  <a href="/laporan" class="<%= currentPath.startsWith('/laporan')?'active':'' %>">Laporan</a>
  <% if (can.manageUsers || can.classes || can.audit || can.backup) { %>
  <div class="nav-title">Administrasi</div>
  <% if (can.manageUsers) { %><a href="/pengguna" class="<%= currentPath.startsWith('/pengguna')?'active':'' %>">Pengguna</a><% } %>
  <% if (can.classes) { %><a href="/kelas" class="<%= currentPath.startsWith('/kelas')?'active':'' %>">Kelas</a><% } %>
  <% if (can.audit) { %><a href="/audit" class="<%= currentPath.startsWith('/audit')?'active':'' %>">Audit Log</a><% } %>
  <% if (can.backup) { %><a href="/backup" class="<%= currentPath.startsWith('/backup')?'active':'' %>">Backup</a><a href="/health/dashboard" class="<%= currentPath.startsWith('/health')?'active':'' %>">System Health</a><% } %>
  <% } %>
</aside>
<label class="mobile-backdrop" for="nav-toggle"></label>
<main class="content">
<% } else { %><main class="auth-content"><% } %>
<% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
