<%- include('page-start') %><div class="page-head"><div><h1><%= mode==='edit'?'Ubah':'Tambah' %> Pengamatan</h1><p class="muted"><%= t.kode_tanaman %> — <%= t.nama_tanaman %></p></div></div><% if(error){ %><div class="flash flash-danger"><%= error %></div><% } %><form method="post" action="<%= mode==='edit'?'/pengamatan/'+id+'/edit':'/pengamatan/baru' %>" class="form-grid"><input type="hidden" name="tanaman_id" value="<%= t.id %>"><label>Tanggal<input type="date" name="tanggal" value="<%= data.tanggal||'' %>" required></label><label>Kondisi Umum<input name="kondisi_umum" value="<%= data.kondisi_umum||'' %>"></label><label>Kondisi Daun<select name="kondisi_daun"><% DAUN.forEach(v=>{ %><option value="<%= v %>" <%= data.kondisi_daun===v?'selected':'' %>><%= v %></option><% }) %></select></label><label>Kondisi Batang<select name="kondisi_batang"><% BATANG.forEach(v=>{ %><option value="<%= v %>" <%= data.kondisi_batang===v?'selected':'' %>><%= v %></option><% }) %></select></label><label>Kondisi Tanah<select name="kondisi_tanah"><% TANAH.forEach(v=>{ %><option value="<%= v %>" <%= data.kondisi_tanah===v?'selected':'' %>><%= v %></option><% }) %></select></label><label>Hama<select name="hama"><% ADA.forEach(v=>{ %><option value="<%= v %>" <%= data.hama===v?'selected':'' %>><%= v %></option><% }) %></select></label><label>Penyakit<select name="penyakit"><% ADA.forEach(v=>{ %><option value="<%= v %>" <%= data.penyakit===v?'selected':'' %>><%= v %></option><% }) %></select></label><label>Kondisi Bunga<input name="kondisi_bunga" value="<%= data.kondisi_bunga||'' %>"></label><label>Kondisi Buah<input name="kondisi_buah" value="<%= data.kondisi_buah||'' %>"></label><label class="col-2">Catatan<textarea name="catatan" rows="4"><%= data.catatan||'' %></textarea></label><div class="col-2 form-actions"><button class="btn btn-primary">Simpan</button><a class="btn" href="/tanaman/<%= t.id %>">Batal</a></div></form><%- include('page-end') %>
