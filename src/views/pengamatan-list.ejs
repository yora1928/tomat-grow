<%- include('page-start') %><div class="page-head"><div><h1>Pengamatan</h1><p class="muted">Catatan kondisi tanaman berdasarkan tanggal.</p></div></div>
<div class="table-wrap"><table class="table"><thead><tr><th>Tanggal</th><th>Tanaman</th><th>Daun</th><th>Batang</th><th>Tanah</th><th>Hama</th><th></th></tr></thead><tbody><% if(items.length){ items.forEach(p=>{ %><tr><td><%= p.tanggal %></td><td><a href="/tanaman/<%= p.tanaman_id %>"><strong><%= p.kode_tanaman %></strong></a></td><td><%= p.kondisi_daun||'-' %></td><td><%= p.kondisi_batang||'-' %></td><td><%= p.kondisi_tanah||'-' %></td><td><%= p.hama||'-' %></td><td class="right"><a href="/pengamatan/<%= p.id %>/edit">Ubah</a></td></tr><% })}else{ %><tr><td colspan="7" class="muted">Belum ada pengamatan.</td></tr><% } %></tbody></table></div><%- include('page-end') %>
