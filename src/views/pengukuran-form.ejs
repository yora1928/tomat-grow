<%- include('page-start') %><div class="page-head"><div><h1><%= mode==='edit'?'Ubah':'Tambah' %> Pengukuran</h1><p class="muted"><%= t.kode_tanaman %> — <%= t.nama_tanaman %></p></div></div><% if(error){ %><div class="flash flash-danger"><%= error %></div><% } %><form method="post" action="<%= mode==='edit'?'/pengukuran/'+id+'/edit':'/pengukuran/baru' %>" class="form-grid"><input type="hidden" name="tanaman_id" value="<%= t.id %>"><label>Tanggal<input type="date" name="tanggal" value="<%= data.tanggal||'' %>" required></label><label>Tinggi (cm)<input type="number" name="tinggi_cm" step="0.1" min="0" value="<%= data.tinggi_cm??'' %>"></label><label>Jumlah Daun<input type="number" name="jumlah_daun" min="0" value="<%= data.jumlah_daun??'' %>"></label><label>Jumlah Cabang<input type="number" name="jumlah_cabang" min="0" value="<%= data.jumlah_cabang??'' %>"></label><label>Diameter Batang (mm)<input type="number" name="diameter_batang_mm" step="0.1" min="0" value="<%= data.diameter_batang_mm??'' %>"></label><label>Jumlah Bunga<input type="number" name="jumlah_bunga" min="0" value="<%= data.jumlah_bunga??'' %>"></label><label>Jumlah Buah<input type="number" name="jumlah_buah" min="0" value="<%= data.jumlah_buah??'' %>"></label><label class="col-2">Catatan<textarea name="catatan" rows="3"><%= data.catatan||'' %></textarea></label><div class="col-2 form-actions"><button class="btn btn-primary">Simpan</button><a class="btn" href="/tanaman/<%= t.id %>">Batal</a></div></form><%- include('page-end') %>
