<%- include('page-start') %><div class="page-head"><div><h1>Pengukuran</h1><p class="muted">Riwayat ukuran pertumbuhan tanaman.</p></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Tanggal</th><th>Tanaman</th><th>Tinggi</th><th>Daun</th><th>Cabang</th><th>Bunga</th><th>Buah</th><th></th></tr></thead><tbody><% if(items.length){items.forEach(p=>{ %><tr><td><%= p.tanggal %></td><td><a href="/tanaman/<%= p.tanaman_id %>"><strong><%= p.kode_tanaman %></strong></a></td><td><%= p.tinggi_cm??'-' %></td><td><%= p.jumlah_daun??'-' %></td><td><%= p.jumlah_cabang??'-' %></td><td><%= p.jumlah_bunga??'-' %></td><td><%= p.jumlah_buah??'-' %></td><td class="right"><a href="/pengukuran/<%= p.id %>/edit">Ubah</a></td></tr><% })}else{ %><tr><td colspan="8" class="muted">Belum ada pengukuran.</td></tr><% } %></tbody></table></div><%- include('page-end') %>
