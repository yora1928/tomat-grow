<%- include('page-start') %><div class="page-head"><div><h1><%= mode==='edit'?'Ubah':'Tambah' %> Perawatan</h1><p class="muted"><%= t.kode_tanaman %> — <%= t.nama_tanaman %></p></div></div><% if(error){ %><div class="flash flash-danger"><%= error %></div><% } %><form method="post" action="<%= mode==='edit'?'/perawatan/'+id+'/edit':'/perawatan/baru' %>" class="form-grid"><input type="hidden" name="tanaman_id" value="<%= t.id %>"><label>Tanggal<input type="date" name="tanggal" value="<%= data.tanggal||'' %>" required></label><label>Jenis Kegiatan<select name="jenis_kegiatan" required><% JENIS.forEach(v=>{ %><option value="<%= v %>" <%= data.jenis_kegiatan===v?'selected':'' %>><%= v %></option><% }) %></select></label><label>Petugas<input name="petugas" value="<%= data.petugas||'' %>"></label><label class="col-2">Keterangan<textarea name="keterangan" rows="3"><%= data.keterangan||'' %></textarea></label><label class="col-2">Hasil<textarea name="hasil" rows="3"><%= data.hasil||'' %></textarea></label><div class="col-2 form-actions"><button class="btn btn-primary">Simpan</button><a class="btn" href="/tanaman/<%= t.id %>">Batal</a></div></form><%- include('page-end') %>
