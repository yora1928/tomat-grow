<%- include('page-start') %><div class="page-head"><div><h1>Perawatan</h1><p class="muted">Kegiatan perawatan tanaman.</p></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Tanggal</th><th>Tanaman</th><th>Jenis</th><th>Petugas</th><th>Keterangan</th><th></th></tr></thead><tbody><% if(items.length){items.forEach(r=>{ %><tr><td><%= r.tanggal %></td><td><a href="/tanaman/<%= r.tanaman_id %>"><strong><%= r.kode_tanaman %></strong></a></td><td><span class="badge"><%= r.jenis_kegiatan %></span></td><td><%= r.petugas||'-' %></td><td><%= r.keterangan||'-' %></td><td class="right"><a href="/perawatan/<%= r.id %>/edit">Ubah</a></td></tr><% })}else{ %><tr><td colspan="6" class="muted">Belum ada perawatan.</td></tr><% } %></tbody></table></div><%- include('page-end') %>
