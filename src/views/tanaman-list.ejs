<%- include('page-start') %>
<div class="page-head"><div><h1>Data Tanaman</h1><p class="muted">Kelola seluruh tanaman yang Anda miliki aksesnya.</p></div><div class="actions"><a class="btn btn-primary" href="/tanaman/baru">+ Tambah Tanaman</a></div></div>
<form method="get" class="filter-bar"><input name="q" value="<%= search %>" placeholder="Cari kode / nama tanaman"><% if(classes.length>1){ %><select name="class_id"><option value="">Semua Kelas</option><% classes.forEach(c=>{ %><option value="<%= c.id %>" <%= class_id===c.id?'selected':'' %>><%= c.kode_kelas %></option><% }) %></select><% } %><select name="status"><option value="">Semua Status</option><% ['Sehat','Bermasalah','Mati','Berbuah','Panen'].forEach(s=>{ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn">Terapkan</button></form>
<% if(tanaman.length){ %><div class="table-wrap"><table class="table"><thead><tr><th>Kode</th><th>Nama</th><th>Kelas</th><th>Varietas</th><th>Tanggal Tanam</th><th>Status</th><th></th></tr></thead><tbody><% tanaman.forEach(t=>{ %><tr><td><a href="/tanaman/<%= t.id %>"><strong><%= t.kode_tanaman %></strong></a></td><td><%= t.nama_tanaman %></td><td><%= t.kode_kelas||'-' %></td><td><%= t.varietas||'-' %></td><td><%= t.tanggal_tanam %></td><td><span class="badge status-<%= t.status.toLowerCase() %>"><%= t.status %></span></td><td class="right"><a class="btn btn-sm" href="/tanaman/<%= t.id %>/edit">Ubah</a><form method="post" action="/tanaman/<%= t.id %>/delete" class="inline" onsubmit="return confirm('Hapus tanaman ini dari daftar aktif?')"><button class="btn btn-sm btn-danger">Hapus</button></form></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty">Belum ada data tanaman yang sesuai.</div><% } %>
<%- include('page-end') %>
