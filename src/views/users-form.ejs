<%- include('page-start') %><div class="page-head"><div><h1><%= mode==='edit'?'Ubah':'Tambah' %> Pengguna</h1></div></div><% if(error){ %><div class="flash flash-danger"><%= error %></div><% } %><form method="post" action="<%= mode==='edit'?'/pengguna/'+u.id+'/edit':'/pengguna/baru' %>" class="form-grid"><label>Username<input name="username" value="<%= data.username||'' %>" <%= mode==='edit'?'readonly':'required' %>></label><label>Email<input type="email" name="email" value="<%= data.email||'' %>" required></label><label>Nama<input name="nama" value="<%= data.nama||'' %>" required></label><label>Password<input type="password" name="password" <%= mode==='create'?'required':'' %>><span class="muted small"><%= mode==='edit'?'Kosongkan jika tidak diubah.':'' %></span></label><label>Role<select name="role" <%= mode==='edit'&&user.role==='KOORDINATOR'?'disabled':'' %>><% roles.forEach(r=>{ %><option value="<%= r %>" <%= data.role===r?'selected':'' %>><%= r %></option><% }) %></select></label><label>Kelas<select name="class_id"><option value="">Tanpa kelas</option><% classes.forEach(c=>{ %><option value="<%= c.id %>" <%= data.class_id==c.id?'selected':'' %>><%= c.kode_kelas %> — <%= c.nama_kelas %></option><% }) %></select></label><label>Status<select name="status"><% ['Aktif','Nonaktif'].forEach(s=>{ %><option value="<%= s %>" <%= (data.status||'Aktif')===s?'selected':'' %>><%= s %></option><% }) %></select></label><div class="col-2 form-actions"><button class="btn btn-primary">Simpan</button><a class="btn" href="/pengguna">Batal</a></div></form><%- include('page-end') %>
