<%- include('page-start') %><div class="page-head"><div><h1>Pengguna</h1><p class="muted">Kelola akun dan hak akses.</p></div><div class="actions"><a class="btn btn-primary" href="/pengguna/baru">+ Tambah Pengguna</a></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Username</th><th>Nama</th><th>Email</th><th>Role</th><th>Kelas</th><th>Status</th><th></th></tr></thead><tbody><% if(users.length){users.forEach(u=>{ %><tr><td><strong><%= u.username %></strong></td><td><%= u.nama %></td><td><%= u.email %></td><td><span class="role-pill role-<%= u.role.toLowerCase() %>"><%= u.role %></span></td><td><%= u.kode_kelas||'-' %></td><td><%= u.status %></td><td class="right"><a class="btn btn-sm" href="/pengguna/<%= u.id %>/edit">Ubah</a><% if(u.role!=='ROOT'){ %><form method="post" action="/pengguna/<%= u.id %>/delete" class="inline" onsubmit="return confirm('Nonaktifkan pengguna ini?')"><button class="btn btn-sm btn-danger">Nonaktifkan</button></form><% } %></td></tr><% })}else{ %><tr><td colspan="7" class="muted">Belum ada pengguna.</td></tr><% } %></tbody></table></div><%- include('page-end') %>
